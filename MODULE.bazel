module(
    name = "emb_platform",
    version = "0.1.0",
)

bazel_dep(name = "emb_toolchain", version = "0.1.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Unit test support (//avr8/mcal/test is consumed by project tests)
bazel_dep(name = "googletest", version = "1.17.0")

# Standalone development of this repo: projects override emb_toolchain with
# their submodule checkout (local_path_override); overrides of non-root modules
# are ignored, so this pin only applies when emb-platform is the root module.
git_override(
    module_name = "emb_toolchain",
    remote = "https://github.com/t0biasm/emb-toolchain.git",
    commit = "9345eca95eb334ce83b402cfbed9dff78b7ac1ee",
)
